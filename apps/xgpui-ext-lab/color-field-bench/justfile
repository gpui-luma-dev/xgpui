# From this directory: just mtl --method sampled --animate
# From the repository root: just --justfile apps/xgpui-ext-lab/color-field-bench/justfile args
# See BUILDING.md for flags and source provenance.
set working-directory := "../../.."
set positional-arguments

manifest := "apps/xgpui-ext-lab/Cargo.toml"
config := ".cargo/validation.toml"

# List commands without launching a window.
default:
    @just --justfile '{{justfile()}}' --list

# Print application flags and defaults.
args:
    cargo run --release --locked --config {{config}} --manifest-path {{manifest}} --bin color-field-bench --target-dir target -- --help

# Build the optimized application without running it.
build:
    cargo build --release --locked --config {{config}} --manifest-path {{manifest}} --bin color-field-bench --target-dir target

# Draw a bounded SV field and quit; --continuous keeps drawing.
ui *args:
    cargo run --release --locked --config {{config}} --manifest-path {{manifest}} --bin color-field-bench --target-dir target -- "$@"

# macOS: Metal FPS/GPU HUD; defaults to a changing hue and saves mtl.json.
[macos]
mtl *args:
    mkdir -p apps/xgpui-ext-lab/color-field-bench/results
    MTL_HUD_ENABLED=1 cargo run --release --locked --config {{config}} --manifest-path {{manifest}} --bin color-field-bench --target-dir target -- --animate --json apps/xgpui-ext-lab/color-field-bench/results/mtl.json "$@"

# Render and validate the SV field through the offscreen renderer.
headless *args:
    mkdir -p apps/xgpui-ext-lab/color-field-bench/results
    cargo run --release --locked --config {{config}} --manifest-path {{manifest}} --bin color-field-bench --target-dir target -- --headless "$@"

# Measure color/quad generation and scene preparation without a renderer.
cpu *args:
    mkdir -p apps/xgpui-ext-lab/color-field-bench/results
    cargo run --release --locked --config {{config}} --manifest-path {{manifest}} --bin color-field-bench --target-dir target -- --headless --cpu-only "$@"

# Five interleaved headless trials per method; requires a NEW output-directory name.
benchmark run: build
    #!/usr/bin/env bash
    set -euo pipefail
    suite_dir={{quote("apps/xgpui-ext-lab/color-field-bench/results/" + run)}}
    mkdir -p apps/xgpui-ext-lab/color-field-bench/results
    mkdir "$suite_dir"
    rustc -Vv > "$suite_dir/compiler.txt"
    git rev-parse HEAD > "$suite_dir/repository-commit.txt"
    git status --short > "$suite_dir/working-tree.txt"
    cp upstream.json "$suite_dir/upstream.json"
    shasum -a 256 apps/xgpui-ext-lab/color-field-bench/src/*.rs apps/xgpui-ext-lab/Cargo.toml apps/xgpui-ext-lab/Cargo.lock .cargo/config.toml .cargo/validation.toml target/release/color-field-bench > "$suite_dir/source-hashes.txt"
    if [[ "$(uname -s)" == Darwin ]]; then
        sysctl -n machdep.cpu.brand_string hw.memsize hw.model > "$suite_dir/hardware.txt"
        system_profiler SPDisplaysDataType > "$suite_dir/displays.txt"
        sw_vers > "$suite_dir/os.txt"
        pmset -g custom > "$suite_dir/power-settings.txt"
        pmset -g batt > "$suite_dir/power-source.txt"
    fi
    for trial in 1 2 3 4 5; do
        for method in layered sampled; do
            echo "$method trial $trial/5"
            report="$suite_dir/$method-$trial"
            if MTL_HUD_ENABLED=0 perl -e 'alarm 60; exec @ARGV or die $!;' target/release/color-field-bench --headless --method "$method" --animate --width 512 --height 384 --samples 128 --hue 210 --warmup 30 --frames 300 --json "$report.json" > "$report.log" 2>&1; then
                echo 0 > "$report.exit-status.txt"
            else
                status=$?
                echo "$status" > "$report.exit-status.txt"
                exit "$status"
            fi
        done
    done

# Formatting, workload tests and Clippy; opens no window.
check:
    cargo fmt --manifest-path {{manifest}} --check
    cargo test --locked --config {{config}} --manifest-path {{manifest}} --bin color-field-bench --target-dir target
    cargo clippy --locked --config {{config}} --manifest-path {{manifest}} --bin color-field-bench --target-dir target --all-targets -- -D warnings
