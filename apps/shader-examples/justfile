# Use here, or `just --justfile apps/shader-examples/justfile ui` from the root.
set working-directory := "../.."
set positional-arguments
manifest := "apps/shader-examples/Cargo.toml"
profile := "dev"
options := "--offline --locked --config .cargo/validation.toml --manifest-path " + manifest + " --target-dir target --profile " + profile

# List recipes.
default:
    @just --justfile '{{justfile()}}' --list

# Launch the local native app with its in-window example selector.
ui *args:
    cargo run {{options}} -- "$@"

# Open the minimal custom fragment shader.
minimal:
    cargo run {{options}} -- minimal

# Open one hundred animated glow badges.
glow:
    cargo run {{options}} -- glow

# Open the adjustable particle workload.
particles:
    cargo run {{options}} -- particles

# Open clipping, transparency and native draw ordering examples.
composition:
    cargo run {{options}} -- composition

# Open native versus shader shadow falloff and color controls.
shadows:
    cargo run {{options}} -- shadows

# Open the soft animated border button on a light background.
borders:
    cargo run {{options}} -- borders

# Build the native app without launching.
build:
    cargo build {{options}}

# Format the app.
fmt:
    cargo fmt --manifest-path {{manifest}}

# Check formatting.
fmt-check:
    cargo fmt --manifest-path {{manifest}} --check

# Lint all native app targets.
lint:
    cargo clippy {{options}} --all-targets -- -D warnings

# Build the companion WASM examples.
wasm *args:
    bash apps/shader-examples/build.sh "$@"

# Serve an already built WASM companion.
serve:
    python3 apps/shader-examples/serve.py

# Kinetic typography: typewriter/wave, stable selection, pause/scrub and authentic copy.
typography *args:
    cargo run {{options}} -- --example typography "$@"
